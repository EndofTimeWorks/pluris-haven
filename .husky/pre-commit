#!/usr/bin/env sh

staged_files="$(mktemp)"
mobile_dart_files="$(mktemp)"
prettier_config="$(git rev-parse --show-toplevel)/.prettierrc.json"
export prettier_config
trap 'rm -f "$staged_files" "$mobile_dart_files"' EXIT HUP INT TERM

git diff --cached --name-only -z --diff-filter=ACMR >"$staged_files"
git diff --cached --name-only -z --diff-filter=ACMR -- \
  ':(glob)mobile/lib/*.dart' \
  ':(glob)mobile/lib/**/*.dart' \
  ':(glob)mobile/test/*.dart' \
  ':(glob)mobile/test/**/*.dart' \
  >"$mobile_dart_files"

if [ -s "$staged_files" ]; then
  xargs -0 -r -n 1 sh -c '
    path="$1"
    git diff --quiet -- "$path" || exit 0

    filename="${path##*/}"
    case "$filename" in
      *.*) extension="${filename##*.}" ;;
      *) extension="tmp" ;;
    esac
    input="$(mktemp "${TMPDIR:-/tmp}/pluris-haven-staged.XXXXXX.${extension}")"
    trap "rm -f \"$input\"" EXIT HUP INT TERM

    git show ":$path" >"$input"
    pnpm exec prettier --config "$prettier_config" --write --ignore-unknown "$input" >/dev/null
    mode="$(git ls-files -s -- "$path" | awk "NR == 1 { print \$1 }")"
    object="$(git hash-object -w "$input")"
    git update-index --cacheinfo "$mode,$object,$path"
  ' sh <"$staged_files"
fi

if [ -s "$mobile_dart_files" ]; then
  xargs -0 -r -n 1 sh -c '
    path="$1"
    git diff --quiet -- "$path" || exit 0

    # Keep the staged snapshot in the source directory. Dart discovers the
    # project formatting options by walking from the file path, so /tmp
    # would format the same source differently from CI and the working tree.
    source_dir="$(dirname "$path")"
    input="$(mktemp "$source_dir/.pluris-haven-staged.XXXXXX.dart")"
    trap "rm -f \"$input\"" EXIT HUP INT TERM

    git show ":$path" >"$input"
    dart format "$input" >/dev/null
    mode="$(git ls-files -s -- "$path" | awk "NR == 1 { print \$1 }")"
    object="$(git hash-object -w "$input")"
    git update-index --cacheinfo "$mode,$object,$path"
  ' sh <"$mobile_dart_files"
fi

pnpm check:l10n
uv run --directory server ruff format --check .
