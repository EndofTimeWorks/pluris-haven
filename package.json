{
  "name": "pluris-haven-tooling",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "husky",
    "format": "git ls-files -z | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown",
    "lint:website": "pnpm --dir website check",
    "lint:server:format": "server/.venv/bin/ruff format --check server/pluris_server server/tests",
    "lint:server": "server/.venv/bin/ruff check server/pluris_server server/tests",
    "lint:shell": "shellcheck scripts/*.sh server/deploy/*.sh",
    "lint:mobile": "cd mobile && dart format --set-exit-if-changed lib test && flutter analyze",
    "test:server": "server/.venv/bin/pytest -q server/tests",
    "test:mobile": "cd mobile && flutter test",
    "lint": "pnpm format:check && pnpm lint:website && pnpm lint:server:format && pnpm lint:server && pnpm lint:shell",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1"
    }
  }
}
