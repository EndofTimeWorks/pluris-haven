PLURIS_ENVIRONMENT=production
PLURIS_DATABASE_URL=postgresql+asyncpg://pluris:replace-me@db:5432/pluris
PLURIS_JWT_SECRET=replace-with-at-least-32-random-bytes
PLURIS_FRIEND_CODE_PEPPER=replace-with-a-different-random-secret
PLURIS_ACCESS_TOKEN_MINUTES=15
PLURIS_REFRESH_TOKEN_DAYS=30
PLURIS_REGISTRATION_ENABLED=false
PLURIS_FRIENDS_ENABLED=false
PLURIS_SERVER_ID=00000000-0000-0000-0000-000000000000
PLURIS_SERVER_NAME=Pluris Haven
PLURIS_SERVER_MODE=official
PLURIS_SERVER_OPERATOR=EndofTimeWorks
PLURIS_PUBLIC_URL=https://api.plurishaven.endoftime.works
PLURIS_PRIVACY_POLICY_URL=https://plurishaven.endoftime.works/privacy
PLURIS_TERMS_URL=https://plurishaven.endoftime.works/terms
PLURIS_SUPPORT_EMAIL=support@endoftime.works
PLURIS_BACKUP_OBJECT_DIR=./data/backups
PLURIS_BACKUP_MAX_CHUNK_BYTES=8388608
PLURIS_BACKUP_MAX_SNAPSHOTS_PER_USER=10
PLURIS_BACKUP_MAX_TOTAL_BYTES_PER_USER=1073741824
PLURIS_FRIEND_REQUEST_COOLDOWN_SECONDS=86400
PLURIS_FRIEND_REQUEST_RATE_LIMIT_ATTEMPTS=10
PLURIS_FRIEND_REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
PLURIS_AUTH_RATE_LIMIT_ATTEMPTS=10
PLURIS_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PLURIS_REFRESH_IP_RATE_LIMIT_ATTEMPTS=120
PLURIS_CORS_ORIGINS=https://plurishaven.endoftime.works
PLURIS_TRUSTED_HOSTS=api.plurishaven.endoftime.works

POSTGRES_DB=pluris
POSTGRES_USER=pluris
POSTGRES_PASSWORD=replace-me
