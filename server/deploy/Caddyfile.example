friends.example.com {
    encode zstd gzip

    @backup_chunks path /v1/backups/snapshots/*/chunks/*
    request_body @backup_chunks {
        max_size 9MB
    }

    @other_requests {
        not path /v1/backups/snapshots/*/chunks/*
    }
    request_body @other_requests {
        max_size 64KB
    }

    @api path /health /ready /.well-known/pluris-haven /v1/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        respond "Not found" 404
    }
}
